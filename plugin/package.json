{
  "name": "plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ui && npm run build:plugin",
    "build:ui": "vite build && node -e \"const fs=require('fs');let h=fs.readFileSync('dist/index.html','utf8');h=h.replace(/ type=\\\"module\\\"/g,'').replace(/ crossorigin/g,'');fs.writeFileSync('dist/index.html',h);\"",
    "build:plugin": "esbuild src/plugin/main.ts --bundle --outfile=dist/plugin/main.js --format=iife --target=es6 --tsconfig=tsconfig.plugin.json",
    "lint": "oxlint .",
    "lint:eslint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit || tsc --noEmit",
    "verify": "run-p lint format:check typecheck test"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/plugin-typings": "^1.123.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.5"
  }
}
