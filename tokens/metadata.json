{
  "$schema": "tokensync/v1",
  "$description": "Project configuration for the token sync pipeline.",

  "version": "1.0.0",

  "themes": ["original", "christmas"],
  "colorSchemes": ["light", "dark"],

  "figma": {
    "$description": "Figma file and Variable Collection configuration.",
    "fileKey": "REPLACE_WITH_FIGMA_FILE_KEY",
    "collections": {
      "primitives": "Primitives",
      "global":     "Global",
      "themes":     "Themes",
      "semantic":   "Semantic"
    },
    "$note": "Themes collection modes: one per named theme (Original, Zero…). Semantic collection modes: Light, Dark (+ any user-added modes like Contrast). Switch theme and color scheme independently in Figma."
  },

  "github": {
    "$description": "GitHub repository and path configuration.",
    "repo":       "your-org/design-tokens",
    "branch":     "main",
    "tokensPath": "tokens/"
  },

  "platforms": {
    "$description": "Output configuration per target platform.",

    "css": {
      "enabled": true,
      "output":  "dist/tokens.css",
      "$description": "Single CSS file. Use [data-theme] and [data-color-scheme] attributes for switching."
    },

    "js": {
      "enabled": true,
      "output":  "dist/{colorScheme}.js",
      "format":  "esm",
      "$description": "ES module per color scheme, resolved through the first theme."
    },

    "ts": {
      "enabled": true,
      "output":  "dist/{colorScheme}.ts",
      "$description": "TypeScript constants per color scheme."
    },

    "dart": {
      "enabled": false,
      "output":  "lib/src/tokens/{colorScheme}.dart",
      "$description": "Dart constants for Flutter."
    },

    "swift": {
      "enabled": false,
      "output":  "Sources/Tokens/{colorScheme}.swift",
      "$description": "Swift constants for iOS/macOS."
    }
  }
}
