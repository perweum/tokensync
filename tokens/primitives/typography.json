{
  "typography": {

    "fontFamily": {
      "$type": "fontFamily",
      "$description": "Use the exact font name as it appears in Figma (must be installed).",
      "sans":  { "$value": "Inter" },
      "serif": { "$value": "Georgia" },
      "mono":  { "$value": "Fira Code" }
    },

    "fontWeight": {
      "$type": "fontWeight",
      "$description": "Named weights matching the font's style names in Figma.",
      "regular":  { "$value": "Regular" },
      "medium":   { "$value": "Medium" },
      "semibold": { "$value": "SemiBold" },
      "bold":     { "$value": "Bold" }
    },

    "fontSize": {
      "$type": "dimension",
      "$description": "Font sizes in px (converted from rem at 16px base).",
      "xs":  { "$value": "12" },
      "sm":  { "$value": "14" },
      "md":  { "$value": "16" },
      "lg":  { "$value": "18" },
      "xl":  { "$value": "20" },
      "2xl": { "$value": "24" },
      "3xl": { "$value": "30" },
      "4xl": { "$value": "36" },
      "5xl": { "$value": "48" },
      "6xl": { "$value": "60" }
    },

    "lineHeight": {
      "$type": "number",
      "$description": "Line height as percentage value (e.g. 150 = 150%).",
      "tight":   { "$value": "120" },
      "snug":    { "$value": "135" },
      "normal":  { "$value": "150" },
      "relaxed": { "$value": "165" }
    },

    "letterSpacing": {
      "$type": "number",
      "$description": "Letter spacing as percentage (e.g. -2 = -2%).",
      "tight":  { "$value": "-2" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "4" },
      "wider":  { "$value": "8" }
    }

  }
}
