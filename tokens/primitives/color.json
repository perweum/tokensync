{
  "color": {
    "$type": "color",

    "black": {
      "$description": "Semi-transparent black — for overlays, shadows and scrim. Scale = opacity (25=4%, 50=5%, 100=10% … 950=solid).",
      "25":  { "$value": "rgba(0, 0, 0, 0.04)" },
      "50":  { "$value": "rgba(0, 0, 0, 0.05)" },
      "100": { "$value": "rgba(0, 0, 0, 0.10)" },
      "200": { "$value": "rgba(0, 0, 0, 0.20)" },
      "300": { "$value": "rgba(0, 0, 0, 0.30)" },
      "400": { "$value": "rgba(0, 0, 0, 0.40)" },
      "500": { "$value": "rgba(0, 0, 0, 0.50)" },
      "600": { "$value": "rgba(0, 0, 0, 0.60)" },
      "700": { "$value": "rgba(0, 0, 0, 0.70)" },
      "800": { "$value": "rgba(0, 0, 0, 0.80)" },
      "900": { "$value": "rgba(0, 0, 0, 0.90)" },
      "950": { "$value": "#000000" }
    },

    "white": {
      "$description": "Semi-transparent white — for overlays on dark surfaces. Scale = opacity (25=4%, 50=5%, 100=10% … 950=solid).",
      "25":  { "$value": "rgba(255, 255, 255, 0.04)" },
      "50":  { "$value": "rgba(255, 255, 255, 0.05)" },
      "100": { "$value": "rgba(255, 255, 255, 0.10)" },
      "200": { "$value": "rgba(255, 255, 255, 0.20)" },
      "300": { "$value": "rgba(255, 255, 255, 0.30)" },
      "400": { "$value": "rgba(255, 255, 255, 0.40)" },
      "500": { "$value": "rgba(255, 255, 255, 0.50)" },
      "600": { "$value": "rgba(255, 255, 255, 0.60)" },
      "700": { "$value": "rgba(255, 255, 255, 0.70)" },
      "800": { "$value": "rgba(255, 255, 255, 0.80)" },
      "900": { "$value": "rgba(255, 255, 255, 0.90)" },
      "950": { "$value": "#ffffff" }
    },

    "neutral": {
      "$description": "Grey scale. Generated from seed via OKLCH.",
      "25":  { "$value": "#f9f9f9" },
      "50":  { "$value": "#f0f0f0" },
      "100": { "$value": "#e0e0e0" },
      "200": { "$value": "#c5c5c5" },
