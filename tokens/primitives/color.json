{
  "color": {
    "$type": "color",

    "black": {
      "100": { "$value": "#000000" },
      "30":  { "$value": "rgba(0, 0, 0, 0.30)" },
      "20":  { "$value": "rgba(0, 0, 0, 0.20)" },
      "10":  { "$value": "rgba(0, 0, 0, 0.10)" },
      "5":   { "$value": "rgba(0, 0, 0, 0.05)" }
    },

    "white": {
      "100": { "$value": "#ffffff" },
      "30":  { "$value": "rgba(255, 255, 255, 0.30)" },
      "20":  { "$value": "rgba(255, 255, 255, 0.20)" },
      "10":  { "$value": "rgba(255, 255, 255, 0.10)" },
      "5":   { "$value": "rgba(255, 255, 255, 0.05)" }
    },

    "neutral": {
      "$description": "Grey scale. Generated from seed via OKLCH.",
      "25":  { "$value": "#f9f9f9" },
      "50":  { "$value": "#f0f0f0" },
      "100": { "$value": "#e0e0e0" },
      "200": { "$value": "#c5c5c5" },
