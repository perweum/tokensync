{
  "$description": "Sub-brand Green — light theme. Sparse override: only brand-role tokens are redefined. All other tokens (neutral text, surfaces, status colours, elevation) inherit from the Masterbrand default.",

  "background": {
    "$type": "color",
    "brand": { "$value": "{color.green.25}" }
  },

  "surface": {
    "$type": "color",
    "brand": {
      "default": { "$value": "{color.green.50}" },
      "hover":   { "$value": "{color.green.100}" },
      "active":  { "$value": "{color.green.200}" }
    }
  },

  "border": {
    "$type": "color",
    "focus": { "$value": "{color.green.600}" },
    "brand": {
      "default": { "$value": "{color.green.200}" },
      "hover":   { "$value": "{color.green.400}" }
    }
  },

  "base": {
    "$type": "color",
    "brand": {
      "default": { "$value": "{color.green.600}" },
      "hover":   { "$value": "{color.green.700}" },
      "active":  { "$value": "{color.green.800}" }
    }
  },

  "text": {
    "$type": "color",
    "brand": {
      "default":  { "$value": "{color.green.700}" },
      "contrast": { "$value": "{color.white.950}" }
    }
  }

}
