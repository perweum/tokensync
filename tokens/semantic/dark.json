{
  "$description": "Semantic colour tokens — dark mode. Brand/neutral tokens alias into the active Theme via {dark.*}. Severity tokens reference primitives directly (identical across all themes).",

  "background": {
    "$type": "color",
    "default":  { "$value": "{dark.background.default}" },
    "subtle":   { "$value": "{dark.background.subtle}" },
    "brand":    { "$value": "{dark.background.brand}" },
    "success":  { "$value": "{color.green.950}" },
    "error":    { "$value": "{color.red.950}" },
    "warning":  { "$value": "{color.amber.950}" },
    "info":     { "$value": "{color.sky.950}" }
  },

  "surface": {
    "$type": "color",
    "default":  { "$value": "{dark.surface.default}" },
    "raised":   { "$value": "{dark.surface.raised}" },
    "overlay":  { "$value": "{dark.surface.overlay}" },
    "disabled": { "$value": "{dark.surface.disabled}" },
    "brand": {
      "default": { "$value": "{dark.surface.brand.default}" },
      "hover":   { "$value": "{dark.surface.brand.hover}" },
      "active":  { "$value": "{dark.surface.brand.active}" }
    },
    "neutral": {
      "default": { "$value": "{dark.surface.neutral.default}" },
      "hover":   { "$value": "{dark.surface.neutral.hover}" },
      "active":  { "$value": "{dark.surface.neutral.active}" }
    },
    "success": {
      "default": { "$value": "{color.green.900}" },
      "hover":   { "$value": "{color.green.800}" },
      "active":  { "$value": "{color.green.700}" }
    },
    "error": {
      "default": { "$value": "{color.red.900}" },
      "hover":   { "$value": "{color.red.800}" },
      "active":  { "$value": "{color.red.700}" }
    },
    "warning": {
      "default": { "$value": "{color.amber.900}" },
      "hover":   { "$value": "{color.amber.800}" },
      "active":  { "$value": "{color.amber.700}" }
    },
    "info": {
      "default": { "$value": "{color.sky.900}" },
      "hover":   { "$value": "{color.sky.800}" },
      "active":  { "$value": "{color.sky.700}" }
    }
  },

  "border": {
    "$type": "color",
    "subtle":   { "$value": "{dark.border.subtle}" },
    "default":  { "$value": "{dark.border.default}" },
    "strong":   { "$value": "{dark.border.strong}" },
    "disabled": { "$value": "{dark.border.disabled}" },
    "focus":    { "$value": "{dark.border.focus}" },
    "brand": {
      "default": { "$value": "{dark.border.brand.default}" },
      "hover":   { "$value": "{dark.border.brand.hover}" }
    },
    "success":  { "default": { "$value": "{color.green.700}" } },
    "error":    { "default": { "$value": "{color.red.700}" } },
    "warning":  { "default": { "$value": "{color.amber.700}" } },
    "info":     { "default": { "$value": "{color.sky.700}" } }
  },

  "base": {
    "$type": "color",
    "disabled": { "$value": "{dark.base.disabled}" },
    "brand": {
      "default": { "$value": "{dark.base.brand.default}" },
      "hover":   { "$value": "{dark.base.brand.hover}" },
      "active":  { "$value": "{dark.base.brand.active}" }
    },
    "neutral": {
      "default": { "$value": "{dark.base.neutral.default}" },
      "hover":   { "$value": "{dark.base.neutral.hover}" },
      "active":  { "$value": "{dark.base.neutral.active}" }
    },
    "success": {
      "default": { "$value": "{color.green.500}" },
      "hover":   { "$value": "{color.green.400}" },
      "active":  { "$value": "{color.green.300}" }
    },
    "error": {
      "default": { "$value": "{color.red.500}" },
      "hover":   { "$value": "{color.red.400}" },
      "active":  { "$value": "{color.red.300}" }
    },
    "warning": {
      "default": { "$value": "{color.amber.500}" },
      "hover":   { "$value": "{color.amber.400}" },
      "active":  { "$value": "{color.amber.300}" }
    },
    "info": {
      "default": { "$value": "{color.sky.500}" },
      "hover":   { "$value": "{color.sky.400}" },
      "active":  { "$value": "{color.sky.300}" }
    }
  },

  "text": {
    "$type": "color",
    "default":  { "$value": "{dark.text.default}" },
    "subtle":   { "$value": "{dark.text.subtle}" },
    "disabled": { "$value": "{dark.text.disabled}" },
    "inverse":  { "$value": "{dark.text.inverse}" },
    "brand": {
      "default":  { "$value": "{dark.text.brand.default}" },
      "contrast": { "$value": "{dark.text.brand.contrast}" }
    },
    "success": {
      "default":  { "$value": "{color.green.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "error": {
      "default":  { "$value": "{color.red.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "warning": {
      "default":  { "$value": "{color.amber.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "info": {
      "default":  { "$value": "{color.sky.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    }
  },

  "icon": {
    "$type": "color",
    "default":  { "$value": "{dark.icon.default}" },
    "subtle":   { "$value": "{dark.icon.subtle}" },
    "disabled": { "$value": "{dark.icon.disabled}" },
    "inverse":  { "$value": "{dark.icon.inverse}" },
    "brand": {
      "default":  { "$value": "{dark.icon.brand.default}" },
      "contrast": { "$value": "{dark.icon.brand.contrast}" }
    },
    "success": {
      "default":  { "$value": "{color.green.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "error": {
      "default":  { "$value": "{color.red.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "warning": {
      "default":  { "$value": "{color.amber.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "info": {
      "default":  { "$value": "{color.sky.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    }
  },

  "elevation": {
    "1": { "$type": "shadow", "$value": "{dark.elevation.1}" },
    "2": { "$type": "shadow", "$value": "{dark.elevation.2}" },
    "3": { "$type": "shadow", "$value": "{dark.elevation.3}" },
    "4": { "$type": "shadow", "$value": "{dark.elevation.4}" }
  },

  "overlay": {
    "default": { "$type": "color", "$value": "{dark.overlay.default}" }
  }
}
