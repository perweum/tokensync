{
  "$description": "Semantic colour tokens — default brand, dark theme. Same structure as light.json — only the primitive references differ.",

  "background": {
    "$type": "color",
    "default":  { "$value": "{color.neutral.950}" },
    "subtle":   { "$value": "{color.neutral.900}" },
    "brand":    { "$value": "{color.blue.950}" },
    "success":  { "$value": "{color.green.950}" },
    "error":    { "$value": "{color.red.950}" },
    "warning":  { "$value": "{color.amber.950}" },
    "info":     { "$value": "{color.sky.950}" }
  },

  "surface": {
    "$type": "color",
    "default":  { "$value": "{color.neutral.900}" },
    "raised":   { "$value": "{color.neutral.800}" },
    "overlay":  { "$value": "{color.neutral.800}" },
    "disabled": { "$value": "{color.neutral.800}" },
    "brand": {
      "default": { "$value": "{color.blue.900}" },
      "hover":   { "$value": "{color.blue.800}" },
      "active":  { "$value": "{color.blue.700}" }
    },
    "success": {
      "default": { "$value": "{color.green.900}" },
      "hover":   { "$value": "{color.green.800}" },
      "active":  { "$value": "{color.green.700}" }
    },
    "error": {
      "default": { "$value": "{color.red.900}" },
      "hover":   { "$value": "{color.red.800}" },
      "active":  { "$value": "{color.red.700}" }
    },
    "warning": {
      "default": { "$value": "{color.amber.900}" },
      "hover":   { "$value": "{color.amber.800}" },
      "active":  { "$value": "{color.amber.700}" }
    },
    "info": {
      "default": { "$value": "{color.sky.900}" },
      "hover":   { "$value": "{color.sky.800}" },
      "active":  { "$value": "{color.sky.700}" }
    }
  },

  "border": {
    "$type": "color",
    "subtle":   { "$value": "{color.neutral.800}" },
    "default":  { "$value": "{color.neutral.700}" },
    "strong":   { "$value": "{color.neutral.500}" },
    "disabled": { "$value": "{color.neutral.700}" },
    "focus":    { "$value": "{color.blue.400}" },
    "brand": {
      "default": { "$value": "{color.blue.700}" },
      "hover":   { "$value": "{color.blue.500}" }
    },
    "success":  { "default": { "$value": "{color.green.700}" } },
    "error":    { "default": { "$value": "{color.red.700}" } },
    "warning":  { "default": { "$value": "{color.amber.700}" } },
    "info":     { "default": { "$value": "{color.sky.700}" } }
  },

  "base": {
    "$type": "color",
    "disabled": { "$value": "{color.neutral.700}" },
    "brand": {
      "default": { "$value": "{color.blue.500}" },
      "hover":   { "$value": "{color.blue.400}" },
      "active":  { "$value": "{color.blue.300}" }
    },
    "neutral": {
      "default": { "$value": "{color.neutral.500}" },
      "hover":   { "$value": "{color.neutral.400}" },
      "active":  { "$value": "{color.neutral.300}" }
    },
    "success": {
      "default": { "$value": "{color.green.500}" },
      "hover":   { "$value": "{color.green.400}" },
      "active":  { "$value": "{color.green.300}" }
    },
    "error": {
      "default": { "$value": "{color.red.500}" },
      "hover":   { "$value": "{color.red.400}" },
      "active":  { "$value": "{color.red.300}" }
    },
    "warning": {
      "default": { "$value": "{color.amber.500}" },
      "hover":   { "$value": "{color.amber.400}" },
      "active":  { "$value": "{color.amber.300}" }
    },
    "info": {
      "default": { "$value": "{color.sky.500}" },
      "hover":   { "$value": "{color.sky.400}" },
      "active":  { "$value": "{color.sky.300}" }
    }
  },

  "text": {
    "$type": "color",
    "default":  { "$value": "{color.neutral.50}" },
    "subtle":   { "$value": "{color.neutral.400}" },
    "disabled": { "$value": "{color.neutral.600}" },
    "inverse":  { "$value": "{color.neutral.950}" },
    "brand": {
      "default":  { "$value": "{color.blue.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "success": {
      "default":  { "$value": "{color.green.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "error": {
      "default":  { "$value": "{color.red.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "warning": {
      "default":  { "$value": "{color.amber.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "info": {
      "default":  { "$value": "{color.sky.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    }
  },

  "icon": {
    "$type": "color",
    "default":  { "$value": "{text.default}" },
    "subtle":   { "$value": "{text.subtle}" },
    "disabled": { "$value": "{text.disabled}" },
    "inverse":  { "$value": "{text.inverse}" },
    "brand": {
      "default":  { "$value": "{text.brand.default}" },
      "contrast": { "$value": "{text.brand.contrast}" }
    },
    "success": {
      "default":  { "$value": "{text.success.default}" },
      "contrast": { "$value": "{text.success.contrast}" }
    },
    "error": {
      "default":  { "$value": "{text.error.default}" },
      "contrast": { "$value": "{text.error.contrast}" }
    },
    "warning": {
      "default":  { "$value": "{text.warning.default}" },
      "contrast": { "$value": "{text.warning.contrast}" }
    },
    "info": {
      "default":  { "$value": "{text.info.default}" },
      "contrast": { "$value": "{text.info.contrast}" }
    }
  },

  "elevation": {
    "$description": "Shadow levels for depth.",
    "1": { "$type": "shadow", "$value": "0 1px 2px {color.black.200}, 0 1px 3px {color.black.300}" },
    "2": { "$type": "shadow", "$value": "0 4px 6px {color.black.300}, 0 2px 4px {color.black.200}" },
    "3": { "$type": "shadow", "$value": "0 10px 15px {color.black.300}, 0 4px 6px {color.black.200}" },
    "4": { "$type": "shadow", "$value": "0 20px 25px {color.black.300}, 0 8px 10px {color.black.200}" }
  },

  "overlay": {
    "$description": "Scrim/overlay behind modals and drawers.",
    "default": { "$type": "color", "$value": "{color.black.300}" }
  }

}
