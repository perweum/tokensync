{
  "$description": "Semantic colour tokens — default brand, dark theme. Same structure as light.json — only the primitive references differ.",

  "background": {
    "$type": "color",
    "default":  { "$value": "{color.neutral.950}" },
    "subtle":   { "$value": "{color.neutral.900}" },
    "brand":    { "$value": "{color.brand.950}" },
    "success":  { "$value": "{color.success.950}" },
    "error":    { "$value": "{color.error.950}" },
    "warning":  { "$value": "{color.warning.950}" },
    "info":     { "$value": "{color.info.950}" }
  },

  "surface": {
    "$type": "color",
    "default":  { "$value": "{color.neutral.900}" },
    "raised":   { "$value": "{color.neutral.800}" },
    "overlay":  { "$value": "{color.neutral.800}" },
    "disabled": { "$value": "{color.neutral.800}" },
    "brand": {
      "default": { "$value": "{color.brand.900}" },
      "hover":   { "$value": "{color.brand.800}" },
      "active":  { "$value": "{color.brand.700}" }
    },
    "success": {
      "default": { "$value": "{color.success.900}" },
      "hover":   { "$value": "{color.success.800}" },
      "active":  { "$value": "{color.success.700}" }
    },
    "error": {
      "default": { "$value": "{color.error.900}" },
      "hover":   { "$value": "{color.error.800}" },
      "active":  { "$value": "{color.error.700}" }
    },
    "warning": {
      "default": { "$value": "{color.warning.900}" },
      "hover":   { "$value": "{color.warning.800}" },
      "active":  { "$value": "{color.warning.700}" }
    },
    "info": {
      "default": { "$value": "{color.info.900}" },
      "hover":   { "$value": "{color.info.800}" },
      "active":  { "$value": "{color.info.700}" }
    }
  },

  "border": {
    "$type": "color",
    "subtle":   { "$value": "{color.neutral.800}" },
    "default":  { "$value": "{color.neutral.700}" },
    "strong":   { "$value": "{color.neutral.500}" },
    "disabled": { "$value": "{color.neutral.700}" },
    "focus":    { "$value": "{color.brand.400}" },
    "brand": {
      "default": { "$value": "{color.brand.700}" },
      "hover":   { "$value": "{color.brand.500}" }
    },
    "success":  { "default": { "$value": "{color.success.700}" } },
    "error":    { "default": { "$value": "{color.error.700}" } },
    "warning":  { "default": { "$value": "{color.warning.700}" } },
    "info":     { "default": { "$value": "{color.info.700}" } }
  },

  "base": {
    "$type": "color",
    "disabled": { "$value": "{color.neutral.700}" },
    "brand": {
      "default": { "$value": "{color.brand.500}" },
      "hover":   { "$value": "{color.brand.400}" },
      "active":  { "$value": "{color.brand.300}" }
    },
    "neutral": {
      "default": { "$value": "{color.neutral.500}" },
      "hover":   { "$value": "{color.neutral.400}" },
      "active":  { "$value": "{color.neutral.300}" }
    },
    "success": {
      "default": { "$value": "{color.success.500}" },
      "hover":   { "$value": "{color.success.400}" },
      "active":  { "$value": "{color.success.300}" }
    },
    "error": {
      "default": { "$value": "{color.error.500}" },
      "hover":   { "$value": "{color.error.400}" },
      "active":  { "$value": "{color.error.300}" }
    },
    "warning": {
      "default": { "$value": "{color.warning.500}" },
      "hover":   { "$value": "{color.warning.400}" },
      "active":  { "$value": "{color.warning.300}" }
    },
    "info": {
      "default": { "$value": "{color.info.500}" },
      "hover":   { "$value": "{color.info.400}" },
      "active":  { "$value": "{color.info.300}" }
    }
  },

  "text": {
    "$type": "color",
    "default":  { "$value": "{color.neutral.50}" },
    "subtle":   { "$value": "{color.neutral.400}" },
    "disabled": { "$value": "{color.neutral.600}" },
    "inverse":  { "$value": "{color.neutral.950}" },
    "brand": {
      "default":  { "$value": "{color.brand.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "success": {
      "default":  { "$value": "{color.success.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "error": {
      "default":  { "$value": "{color.error.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "warning": {
      "default":  { "$value": "{color.warning.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    },
    "info": {
      "default":  { "$value": "{color.info.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    }
  },

  "icon": {
    "$type": "color",
    "default":  { "$value": "{text.default}" },
    "subtle":   { "$value": "{text.subtle}" },
    "disabled": { "$value": "{text.disabled}" },
    "inverse":  { "$value": "{text.inverse}" },
    "brand": {
      "default":  { "$value": "{text.brand.default}" },
      "contrast": { "$value": "{text.brand.contrast}" }
    },
    "success": {
      "default":  { "$value": "{text.success.default}" },
      "contrast": { "$value": "{text.success.contrast}" }
    },
    "error": {
      "default":  { "$value": "{text.error.default}" },
      "contrast": { "$value": "{text.error.contrast}" }
    },
    "warning": {
      "default":  { "$value": "{text.warning.default}" },
      "contrast": { "$value": "{text.warning.contrast}" }
    },
    "info": {
      "default":  { "$value": "{text.info.default}" },
      "contrast": { "$value": "{text.info.contrast}" }
    }
  },

  "elevation": {
    "1": { "$type": "shadow", "$value": "0 1px 2px {color.black.20}, 0 1px 3px {color.black.30}" },
    "2": { "$type": "shadow", "$value": "0 4px 6px {color.black.30}, 0 2px 4px {color.black.20}" },
    "3": { "$type": "shadow", "$value": "0 10px 15px {color.black.30}, 0 4px 6px {color.black.20}" },
    "4": { "$type": "shadow", "$value": "0 20px 25px {color.black.30}, 0 8px 10px {color.black.20}" }
  },

  "overlay": {
    "default": { "$type": "color", "$value": "{color.black.30}" }
  }

}
