{
  "$description": "Semantic colour tokens — default brand, light theme. References colour primitives only.",

  "background": {
    "$type": "color",
    "$description": "Full-page and section backgrounds. Should never carry interactive states.",
    "default":  { "$value": "{color.white.950}", "$description": "Base page background" },
    "subtle":   { "$value": "{color.neutral.25}", "$description": "Slightly tinted background (sidebars, code blocks)" },
    "brand":    { "$value": "{color.blue.25}" },
    "success":  { "$value": "{color.green.25}" },
    "error":    { "$value": "{color.red.25}" },
    "warning":  { "$value": "{color.amber.25}" },
    "info":     { "$value": "{color.sky.25}" }
  },

  "surface": {
    "$type": "color",
    "$description": "Component surfaces (cards, modals, inputs). Carry interactive states.",
    "default":  { "$value": "{color.white.950}" },
    "raised":   { "$value": "{color.white.950}", "$description": "Elevated surface — pair with elevation shadow" },
    "overlay":  { "$value": "{color.white.950}", "$description": "Modal overlays, popovers" },
    "disabled": { "$value": "{color.neutral.50}" },
    "brand": {
      "default": { "$value": "{color.blue.50}" },
      "hover":   { "$value": "{color.blue.100}" },
      "active":  { "$value": "{color.blue.200}" }
    },
    "success": {
      "default": { "$value": "{color.green.50}" },
      "hover":   { "$value": "{color.green.100}" },
      "active":  { "$value": "{color.green.200}" }
    },
    "error": {
      "default": { "$value": "{color.red.50}" },
      "hover":   { "$value": "{color.red.100}" },
      "active":  { "$value": "{color.red.200}" }
    },
    "warning": {
      "default": { "$value": "{color.amber.50}" },
      "hover":   { "$value": "{color.amber.100}" },
      "active":  { "$value": "{color.amber.200}" }
    },
    "info": {
      "default": { "$value": "{color.sky.50}" },
      "hover":   { "$value": "{color.sky.100}" },
      "active":  { "$value": "{color.sky.200}" }
    }
  },

  "border": {
    "$type": "color",
    "$description": "Border and divider colours.",
    "subtle":   { "$value": "{color.neutral.100}", "$description": "Hairline dividers, very subtle" },
    "default":  { "$value": "{color.neutral.200}", "$description": "Standard component borders" },
    "strong":   { "$value": "{color.neutral.400}", "$description": "High-emphasis borders" },
    "disabled": { "$value": "{color.neutral.200}" },
    "focus":    { "$value": "{color.blue.600}", "$description": "Focus ring colour. Must meet 3:1 against background." },
    "brand": {
      "default": { "$value": "{color.blue.200}" },
      "hover":   { "$value": "{color.blue.400}" }
    },
    "success":  { "default": { "$value": "{color.green.300}" } },
    "error":    { "default": { "$value": "{color.red.300}" } },
    "warning":  { "default": { "$value": "{color.amber.300}" } },
    "info":     { "default": { "$value": "{color.sky.300}" } }
  },

  "base": {
    "$type": "color",
    "$description": "Solid filled surfaces for interactive elements (buttons, tags, badges). 500 is the base step across all palettes.",
    "disabled": { "$value": "{color.neutral.200}" },
    "brand": {
      "default": { "$value": "{color.blue.600}" },
      "hover":   { "$value": "{color.blue.700}" },
      "active":  { "$value": "{color.blue.800}" }
    },
    "neutral": {
      "default": { "$value": "{color.neutral.600}" },
      "hover":   { "$value": "{color.neutral.700}" },
      "active":  { "$value": "{color.neutral.800}" }
    },
    "success": {
      "default": { "$value": "{color.green.600}" },
      "hover":   { "$value": "{color.green.700}" },
      "active":  { "$value": "{color.green.800}" }
    },
    "error": {
      "default": { "$value": "{color.red.600}" },
      "hover":   { "$value": "{color.red.700}" },
      "active":  { "$value": "{color.red.800}" }
    },
    "warning": {
      "default": { "$value": "{color.amber.500}" },
      "hover":   { "$value": "{color.amber.600}" },
      "active":  { "$value": "{color.amber.700}" }
    },
    "info": {
      "default": { "$value": "{color.sky.600}" },
      "hover":   { "$value": "{color.sky.700}" },
      "active":  { "$value": "{color.sky.800}" }
    }
  },

  "text": {
    "$type": "color",
    "$description": "Text colours.",
    "default":  { "$value": "{color.neutral.950}", "$description": "Primary body text" },
    "subtle":   { "$value": "{color.neutral.600}", "$description": "Secondary / supporting text" },
    "disabled": { "$value": "{color.neutral.400}" },
    "inverse":  { "$value": "{color.white.950}", "$description": "Text on dark/filled surfaces" },
    "brand": {
      "default":  { "$value": "{color.blue.700}" },
      "contrast": { "$value": "{color.white.950}", "$description": "Text placed on base.brand surface" }
    },
    "success": {
      "default":  { "$value": "{color.green.700}" },
      "contrast": { "$value": "{color.white.950}" }
    },
    "error": {
      "default":  { "$value": "{color.red.700}" },
      "contrast": { "$value": "{color.white.950}" }
    },
    "warning": {
      "default":  { "$value": "{color.amber.800}" },
      "contrast": { "$value": "{color.white.950}" }
    },
    "info": {
      "default":  { "$value": "{color.sky.700}" },
      "contrast": { "$value": "{color.white.950}" }
    }
  },

  "icon": {
    "$type": "color",
    "$description": "Icon colours. Alias over text tokens — icons and their sibling text should always use matching tokens.",
    "default":  { "$value": "{text.default}" },
    "subtle":   { "$value": "{text.subtle}" },
    "disabled": { "$value": "{text.disabled}" },
    "inverse":  { "$value": "{text.inverse}" },
    "brand": {
      "default":  { "$value": "{text.brand.default}" },
      "contrast": { "$value": "{text.brand.contrast}" }
    },
    "success": {
      "default":  { "$value": "{text.success.default}" },
      "contrast": { "$value": "{text.success.contrast}" }
    },
    "error": {
      "default":  { "$value": "{text.error.default}" },
      "contrast": { "$value": "{text.error.contrast}" }
    },
    "warning": {
      "default":  { "$value": "{text.warning.default}" },
      "contrast": { "$value": "{text.warning.contrast}" }
    },
    "info": {
      "default":  { "$value": "{text.info.default}" },
      "contrast": { "$value": "{text.info.contrast}" }
    }
  },

  "elevation": {
    "$description": "Shadow levels for depth. Colours use semi-transparent black.",
    "1": { "$type": "shadow", "$value": "0 1px 2px {color.black.50}, 0 1px 3px {color.black.100}" },
    "2": { "$type": "shadow", "$value": "0 4px 6px {color.black.100}, 0 2px 4px {color.black.50}" },
    "3": { "$type": "shadow", "$value": "0 10px 15px {color.black.100}, 0 4px 6px {color.black.50}" },
    "4": { "$type": "shadow", "$value": "0 20px 25px {color.black.100}, 0 8px 10px {color.black.50}" }
  },

  "overlay": {
    "$description": "Scrim/overlay behind modals and drawers.",
    "default": { "$type": "color", "$value": "{color.black.300}" }
  }

}
