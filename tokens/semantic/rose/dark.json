{
  "$description": "Sub-brand Rose — dark theme. Sparse override: brand role mapped to the red palette.",

  "background": {
    "$type": "color",
    "brand": { "$value": "{color.red.950}" }
  },

  "surface": {
    "$type": "color",
    "brand": {
      "default": { "$value": "{color.red.900}" },
      "hover":   { "$value": "{color.red.800}" },
      "active":  { "$value": "{color.red.700}" }
    }
  },

  "border": {
    "$type": "color",
    "focus": { "$value": "{color.red.400}" },
    "brand": {
      "default": { "$value": "{color.red.700}" },
      "hover":   { "$value": "{color.red.500}" }
    }
  },

  "base": {
    "$type": "color",
    "brand": {
      "default": { "$value": "{color.red.500}" },
      "hover":   { "$value": "{color.red.400}" },
      "active":  { "$value": "{color.red.300}" }
    }
  },

  "text": {
    "$type": "color",
    "brand": {
      "default":  { "$value": "{color.red.300}" },
      "contrast": { "$value": "{color.neutral.950}" }
    }
  }

}
