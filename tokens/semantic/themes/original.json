{
  "$description": "Theme: Original. Complete light and dark semantic token set. Light values listed first, dark second. References colour primitives directly — Semantic collection references these via {light.*} and {dark.*} aliases.",

  "light": {
    "background": {
      "$type": "color",
      "default":  { "$value": "{color.white.950}", "$description": "Base page background" },
      "subtle":   { "$value": "{color.neutral.25}", "$description": "Slightly tinted background (sidebars, code blocks)" },
      "brand":    { "$value": "{color.blue.25}" }
    },

    "surface": {
      "$type": "color",
      "default":  { "$value": "{color.white.950}" },
      "raised":   { "$value": "{color.white.950}", "$description": "Elevated surface — pair with elevation shadow" },
      "overlay":  { "$value": "{color.white.950}", "$description": "Modal overlays, popovers" },
      "disabled": { "$value": "{color.neutral.50}" },
      "brand": {
        "default": { "$value": "{color.blue.50}" },
        "hover":   { "$value": "{color.blue.100}" },
        "active":  { "$value": "{color.blue.200}" }
      },
      "neutral": {
        "default": { "$value": "{color.neutral.50}" },
        "hover":   { "$value": "{color.neutral.100}" },
        "active":  { "$value": "{color.neutral.200}" }
      }
    },

    "border": {
      "$type": "color",
      "subtle":   { "$value": "{color.neutral.100}", "$description": "Hairline dividers, very subtle" },
      "default":  { "$value": "{color.neutral.200}", "$description": "Standard component borders" },
      "strong":   { "$value": "{color.neutral.400}", "$description": "High-emphasis borders" },
      "disabled": { "$value": "{color.neutral.200}" },
      "focus":    { "$value": "{color.blue.600}", "$description": "Focus ring. Must meet 3:1 against background." },
      "brand": {
        "default": { "$value": "{color.blue.200}" },
        "hover":   { "$value": "{color.blue.400}" }
      }
    },

    "base": {
      "$type": "color",
      "disabled": { "$value": "{color.neutral.200}" },
      "brand": {
        "default": { "$value": "{color.blue.600}" },
        "hover":   { "$value": "{color.blue.700}" },
        "active":  { "$value": "{color.blue.800}" }
      },
      "neutral": {
        "default": { "$value": "{color.neutral.600}" },
        "hover":   { "$value": "{color.neutral.700}" },
        "active":  { "$value": "{color.neutral.800}" }
      }
    },

    "text": {
      "$type": "color",
      "default":  { "$value": "{color.neutral.950}", "$description": "Primary body text" },
      "subtle":   { "$value": "{color.neutral.600}", "$description": "Secondary / supporting text" },
      "disabled": { "$value": "{color.neutral.400}" },
      "inverse":  { "$value": "{color.white.950}", "$description": "Text on dark/filled surfaces" },
      "brand": {
        "default":  { "$value": "{color.blue.700}" },
        "contrast": { "$value": "{color.white.950}", "$description": "Text placed on base.brand surface" }
      }
    },

    "icon": {
      "$type": "color",
      "default":  { "$value": "{light.text.default}" },
      "subtle":   { "$value": "{light.text.subtle}" },
      "disabled": { "$value": "{light.text.disabled}" },
      "inverse":  { "$value": "{light.text.inverse}" },
      "brand": {
        "default":  { "$value": "{light.text.brand.default}" },
        "contrast": { "$value": "{light.text.brand.contrast}" }
      }
    },

    "elevation": {
      "1": { "$type": "shadow", "$value": "0 1px 2px {color.black.50}, 0 1px 3px {color.black.100}" },
      "2": { "$type": "shadow", "$value": "0 4px 6px {color.black.100}, 0 2px 4px {color.black.50}" },
      "3": { "$type": "shadow", "$value": "0 10px 15px {color.black.100}, 0 4px 6px {color.black.50}" },
      "4": { "$type": "shadow", "$value": "0 20px 25px {color.black.100}, 0 8px 10px {color.black.50}" }
    },

    "overlay": {
      "default": { "$type": "color", "$value": "{color.black.300}" }
    }
  },

  "dark": {
    "background": {
      "$type": "color",
      "default":  { "$value": "{color.neutral.950}" },
      "subtle":   { "$value": "{color.neutral.900}" },
      "brand":    { "$value": "{color.blue.950}" }
    },

    "surface": {
      "$type": "color",
      "default":  { "$value": "{color.neutral.900}" },
      "raised":   { "$value": "{color.neutral.800}" },
      "overlay":  { "$value": "{color.neutral.800}" },
      "disabled": { "$value": "{color.neutral.800}" },
      "brand": {
        "default": { "$value": "{color.blue.900}" },
        "hover":   { "$value": "{color.blue.800}" },
        "active":  { "$value": "{color.blue.700}" }
      },
      "neutral": {
        "default": { "$value": "{color.neutral.800}" },
        "hover":   { "$value": "{color.neutral.700}" },
        "active":  { "$value": "{color.neutral.600}" }
      }
    },

    "border": {
      "$type": "color",
      "subtle":   { "$value": "{color.neutral.800}" },
      "default":  { "$value": "{color.neutral.700}" },
      "strong":   { "$value": "{color.neutral.500}" },
      "disabled": { "$value": "{color.neutral.700}" },
      "focus":    { "$value": "{color.blue.400}" },
      "brand": {
        "default": { "$value": "{color.blue.700}" },
        "hover":   { "$value": "{color.blue.500}" }
      }
    },

    "base": {
      "$type": "color",
      "disabled": { "$value": "{color.neutral.700}" },
      "brand": {
        "default": { "$value": "{color.blue.500}" },
        "hover":   { "$value": "{color.blue.400}" },
        "active":  { "$value": "{color.blue.300}" }
      },
      "neutral": {
        "default": { "$value": "{color.neutral.500}" },
        "hover":   { "$value": "{color.neutral.400}" },
        "active":  { "$value": "{color.neutral.300}" }
      }
    },

    "text": {
      "$type": "color",
      "default":  { "$value": "{color.neutral.50}" },
      "subtle":   { "$value": "{color.neutral.400}" },
      "disabled": { "$value": "{color.neutral.600}" },
      "inverse":  { "$value": "{color.neutral.950}" },
      "brand": {
        "default":  { "$value": "{color.blue.300}" },
        "contrast": { "$value": "{color.neutral.950}", "$description": "Text placed on base.brand surface — near-black in dark mode" }
      }
    },

    "icon": {
      "$type": "color",
      "default":  { "$value": "{dark.text.default}" },
      "subtle":   { "$value": "{dark.text.subtle}" },
      "disabled": { "$value": "{dark.text.disabled}" },
      "inverse":  { "$value": "{dark.text.inverse}" },
      "brand": {
        "default":  { "$value": "{dark.text.brand.default}" },
        "contrast": { "$value": "{dark.text.brand.contrast}" }
      }
    },

    "elevation": {
      "1": { "$type": "shadow", "$value": "0 1px 2px {color.black.200}, 0 1px 3px {color.black.300}" },
      "2": { "$type": "shadow", "$value": "0 4px 6px {color.black.300}, 0 2px 4px {color.black.200}" },
      "3": { "$type": "shadow", "$value": "0 10px 15px {color.black.300}, 0 4px 6px {color.black.200}" },
      "4": { "$type": "shadow", "$value": "0 20px 25px {color.black.300}, 0 8px 10px {color.black.200}" }
    },

    "overlay": {
      "default": { "$type": "color", "$value": "{color.black.300}" }
    }
  }
}
