    "300": { "$value": "{color.blue.300}" },
    "400": { "$value": "{color.blue.400}" },
    "500": { "$value": "{color.blue.500}" },
    "600": { "$value": "{color.blue.600}" },
    "700": { "$value": "{color.blue.700}" },
    "800": { "$value": "{color.blue.800}" },
    "900": { "$value": "{color.blue.900}" },
    "950": { "$value": "{color.blue.950}" }
  }
